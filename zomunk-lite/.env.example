# ---------------------------------------------------------------------------
# zomunk-lite configuration. Copy to .env and fill in. Never commit .env.
# ---------------------------------------------------------------------------

# --- Flight data provider ---------------------------------------------------
# amadeus = real fares from the Amadeus Self-Service API (free test tier).
# sample  = offline fixtures in data/sample-offers.json (no network, no keys).
ZOMUNK_PROVIDER=sample

# Amadeus Self-Service credentials: https://developers.amadeus.com/register
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
# test = free sandbox (cached fares), production = live fares (paid tier)
AMADEUS_ENV=test

# --- Notifications (Sender) -------------------------------------------------
# Settings -> API access tokens in your Sender account.
SENDER_API_TOKEN=
# Group IDs from `php bin/sender-check.php` (Sender calls these "groups").
SENDER_GROUP_FREE=
SENDER_GROUP_PREMIUM=
SENDER_FROM_EMAIL=deals@example.com
SENDER_FROM_NAME=Zomunk Lite
SENDER_REPLY_TO=deals@example.com

# --- Storage ----------------------------------------------------------------
# Any PDO DSN. Default is a zero-setup SQLite file.
ZOMUNK_DB_DSN=sqlite:/home/user/scripting/zomunk-lite/var/zomunk.sqlite
ZOMUNK_DB_USER=
ZOMUNK_DB_PASSWORD=

# --- Deal rules -------------------------------------------------------------
# A fare must be at least this far below the route's typical fare to be a deal.
ZOMUNK_MIN_DISCOUNT=0.40
# At or above this discount the deal is treated as premium-only (mistake fares).
ZOMUNK_PREMIUM_DISCOUNT=0.70
# Free members see qualifying economy deals this many hours after premium.
ZOMUNK_FREE_DELAY_HOURS=24
# Itinerary quality gates.
ZOMUNK_MAX_STOPS=2
ZOMUNK_MIN_LAYOVER_MINUTES=45
ZOMUNK_MAX_LAYOVER_MINUTES=300
ZOMUNK_REQUIRE_CHECKED_BAG=1
# Passport used for the transit-visa filter (see config/transit_visa.php).
ZOMUNK_PASSPORT=IN
# Re-alert the same route only if the price drops this much below the last
# alerted price, or after ZOMUNK_REALERT_DAYS.
ZOMUNK_REALERT_DROP=0.10
ZOMUNK_REALERT_DAYS=14

# Public dashboard base URL, used to build links inside emails.
ZOMUNK_BASE_URL=http://localhost:8000
